rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function base(code) { return get(/databases/$(database)/documents/sparkTrips/$(code)).data; }
    function owner(code) { return signed() && base(code).ownerUid == request.auth.uid; }
    function member(code) {
      return signed() && (owner(code) || exists(/databases/$(database)/documents/sparkTrips/$(code)/members/$(request.auth.uid)));
    }
    function studentIdentity(code) {
      return signed() && (request.auth.token.firebase.sign_in_provider == 'anonymous'
        || (request.auth.token.firebase.sign_in_provider == 'password'
          && request.auth.token.email.matches('^' + code.lower() + '[.][a-f0-9]{48}@student[.]gilju-trip[.]invalid$')));
    }
    function student(code) { return member(code) && studentIdentity(code); }
    function short(s, length) { return s is string && s.size() <= length; }
    function image(s) { return short(s, 240023) && s.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'); }
    function uuid(s) { return s is string && s.matches('^[a-f0-9-]{36}$'); }
    function fixedRoom(code) { return code in ['GILJU6AA','GILJU6AB','GILJU6AC','GILJU6AD','GILJU6AE']; }
    function roomName(code) { return {'GILJU6AA':'6학년 1반','GILJU6AB':'6학년 2반','GILJU6AC':'6학년 3반','GILJU6AD':'6학년 4반','GILJU6AE':'6학년 5반'}[code]; }
    function name(s) { return short(s,20) && s.size() > 0 && s.matches('.*[^ ].*'); }
    function meeting(m, code) {
      return m is map && m.keys().hasOnly(['place','time','note','photoId'])
        && short(m.place,100) && m.place.size() > 0 && short(m.note,200)
        && m.time is string && m.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && (m.photoId == '' || (uuid(m.photoId) && exists(/databases/$(database)/documents/sparkTrips/$(code)/photos/$(m.photoId))));
    }
    function trip(d,code) {
      return d.keys().hasOnly(['ownerUid','createdAt','updatedAt','className','teacherName','title','startDate','activeDay','daysJson','missionIds','meeting'])
        && short(d.ownerUid,128) && d.createdAt is timestamp && d.updatedAt == request.time
        && short(d.className,40) && d.className.size() > 0 && short(d.teacherName,40)
        && (!fixedRoom(code) || d.className == roomName(code))
        && short(d.title,100) && short(d.startDate,10) && d.activeDay in [1,2,3]
        && short(d.daysJson,500000) && d.missionIds is list && d.missionIds.size() <= 480
        && (meeting(d.meeting,code) || (d.meeting is map && d.meeting.keys().hasOnly(['place','time','note','photoId']) && d.meeting.place == '' && d.meeting.time == '' && d.meeting.note == '' && d.meeting.photoId == ''));
    }
    match /sparkTrips/{code} {
      allow get: if member(code);
      allow list, delete: if false;
      allow create: if signed() && code.matches('^[A-Z2-9]{8}$')
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == code.lower() + '@class.gilju-trip.invalid'
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time && trip(request.resource.data,code);
      allow update: if owner(code) && trip(request.resource.data,code)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt;

      match /members/{uid} {
        allow get: if signed() && (uid == request.auth.uid || owner(code));
        allow list: if owner(code);
        allow create, update: if signed() && uid == request.auth.uid
          && exists(/databases/$(database)/documents/sparkTrips/$(code))
          && studentIdentity(code)
          && (!fixedRoom(code) || request.auth.token.firebase.sign_in_provider == 'password')
          && request.resource.data.keys().hasOnly(['name','joinedAt']) && request.resource.data.joinedAt == request.time
          && (fixedRoom(code) ? name(request.resource.data.name) : (!('name' in request.resource.data) || name(request.resource.data.name)));
        allow delete: if signed() && (uid == request.auth.uid || (owner(code) && uid != base(code).ownerUid));
      }
      match /photos/{id} {
        allow get: if member(code);
        allow list: if owner(code);
        allow create: if owner(code) && uuid(id)
          && request.resource.data.keys().hasOnly(['photoData','ownerUid','createdAt'])
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.createdAt == request.time && image(request.resource.data.photoData);
        allow update, delete: if false;
      }
      match /submissions/{id} {
        allow read: if member(code) && (owner(code) || resource.data.studentUid == request.auth.uid);
        allow create, update: if student(code)
          && request.resource.data.keys().hasOnly(['studentUid','studentName','missionId','photoData','submittedAt'])
          && request.resource.data.studentUid == request.auth.uid
          && (fixedRoom(code) ? (name(request.resource.data.studentName) && request.resource.data.studentName == get(/databases/$(database)/documents/sparkTrips/$(code)/members/$(request.auth.uid)).data.name) : !('studentName' in request.resource.data) || name(request.resource.data.studentName))
          && request.resource.data.missionId is string && request.resource.data.missionId.matches('^[A-Za-z0-9_-]{1,100}$')
          && id == request.auth.uid + '_' + request.resource.data.missionId
          && request.resource.data.missionId in base(code).missionIds
          && request.resource.data.submittedAt == request.time && image(request.resource.data.photoData);
        allow delete: if student(code) && resource.data.studentUid == request.auth.uid;
      }
      match /progress/{uid} {
        allow get: if member(code) && (owner(code) || uid == request.auth.uid);
        allow list: if owner(code);
        allow create, update: if student(code) && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['completedMissions','updatedAt'])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.completedMissions is list && request.resource.data.completedMissions.size() <= 480
          && base(code).missionIds.hasAll(request.resource.data.completedMissions);
        allow delete: if false;
      }
      match /teacherMaterials/{id} {
        allow get: if owner(code);
        allow list, create, update, delete: if false;
      }
      match /eventDetails/{id} {
        allow get: if member(code);
        allow list, delete: if false;
        allow create, update: if owner(code)
          && request.resource.data.keys().hasOnly(['eventId','description','photoId','updatedAt'])
          && short(request.resource.data.eventId,100) && request.resource.data.eventId.size() > 0
          && short(request.resource.data.description,4000)
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.photoId == '' || (uuid(request.resource.data.photoId)
            && exists(/databases/$(database)/documents/sparkTrips/$(code)/photos/$(request.resource.data.photoId))));
      }
      match /alerts/{id} {
        allow read: if member(code);
        allow create: if owner(code) && uuid(id)
          && request.resource.data.keys().hasOnly(['place','time','note','photoId','createdAt'])
          && request.resource.data.createdAt == request.time
          && meeting({'place':request.resource.data.place,'time':request.resource.data.time,'note':request.resource.data.note,'photoId':request.resource.data.photoId},code);
        allow update: if false;
        allow delete: if owner(code);
      }
      match /pushSubscriptions/{uid} {
        allow get: if member(code) && (uid == request.auth.uid || owner(code));
        allow list: if owner(code);
        allow create, update: if student(code) && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['endpoint','p256dh','auth','updatedAt'])
          && short(request.resource.data.endpoint,2048) && request.resource.data.endpoint.matches('^https://[^ @]+$')
          && request.resource.data.p256dh is string && request.resource.data.p256dh.matches('^[A-Za-z0-9_-]{87}$')
          && request.resource.data.auth is string && request.resource.data.auth.matches('^[A-Za-z0-9_-]{22}$')
          && request.resource.data.updatedAt == request.time;
        allow delete: if signed() && (uid == request.auth.uid || owner(code));
      }
      match /pushDispatches/{id} {
        allow get: if owner(code);
        allow list, delete: if false;
        allow create, update: if owner(code)
          && request.resource.data.keys().hasOnly(['alertId','studentUid','status','updatedAt'])
          && uuid(request.resource.data.alertId) && short(request.resource.data.studentUid,128)
          && id == request.resource.data.alertId + '_' + request.resource.data.studentUid
          && request.resource.data.status in ['sending','accepted','failed','expired']
          && request.resource.data.updatedAt == request.time
          && exists(/databases/$(database)/documents/sparkTrips/$(code)/alerts/$(request.resource.data.alertId));
      }
      match /receipts/{id} {
        allow get: if member(code) && (owner(code) || id.matches('^[a-f0-9-]{36}_' + request.auth.uid + '$'));
        allow list: if member(code) && (owner(code) || resource.data.studentUid == request.auth.uid);
        allow create: if student(code) && request.resource.data.keys().hasOnly(['alertId','studentUid','createdAt'])
          && request.resource.data.studentUid == request.auth.uid && uuid(request.resource.data.alertId)
          && id == request.resource.data.alertId + '_' + request.auth.uid
          && exists(/databases/$(database)/documents/sparkTrips/$(code)/alerts/$(request.resource.data.alertId))
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
    // The previous server-only collections remain private.
    match /{document=**} { allow read, write: if false; }
  }
}
