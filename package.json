{
  "name": "gilju-grade6-trip",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "emulators": "firebase emulators:start --project demo-gilju-trip --only auth,firestore --import=work/local-emulator-data --export-on-exit=work/local-emulator-data",
    "test:local": "node scripts/test-free.mjs",
    "setup:local": "node --env-file=.env.local scripts/setup-local-classrooms.mjs",
    "backup:local": "node scripts/backup-local.mjs",
    "test:classrooms": "node --env-file=.env.local scripts/test-classrooms.mjs",
    "deploy": "npm run build && firebase deploy --only firestore,hosting"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "lucide-react": "^1.31.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
